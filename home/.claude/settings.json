{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "DISABLE_AUTOUPDATER": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "DISABLE_TELEMETRY": "1",
    "USE_BUILTIN_RIPGREP": "0"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Read(~/.config/zsh/.zshrc)",
      "Bash(gh search *)",
      "Bash(python3 *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "skillOverrides": {
    "linear-cli": "off"
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/permission-alert.sh"
          }
        ]
      },
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/idle-notification.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/block-force-push.sh",
            "statusMessage": "Checking for force push..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/tool-usage-logger.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/agent-memory/hooks/inject.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/agent-memory/hooks/save-session.sh",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash /Users/andrew.mason/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "plugin-dev@claude-plugins-official": false,
    "ruby-lsp@claude-plugins-official": false,
    "ruby-lsp@podia-plugins": false,
    "swift-lsp@claude-plugins-official": false,
    "warp@claude-code-warp": true,
    "deslop@podia-plugins": false,
    "skill-creator@podia-plugins": false,
    "claude-code-setup@claude-plugins-official": false,
    "stripe@claude-plugins-official": false,
    "review-companion@podia-plugins": true,
    "gopls-lsp@claude-plugins-official": false,
    "i-have-adhd@i-have-adhd": true,
    "figma@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "podia-plugins": {
      "source": {
        "source": "github",
        "repo": "podia/claude-plugins"
      }
    },
    "skills-janitor": {
      "source": {
        "source": "github",
        "repo": "khendzel/skills-janitor"
      }
    },
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      }
    },
    "i-have-adhd": {
      "source": {
        "source": "github",
        "repo": "ayghri/i-have-adhd"
      }
    },
    "ombulabs-ai": {
      "source": {
        "source": "git",
        "url": "https://github.com/ombulabs/claude-skills.git"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "editorMode": "vim",
  "teammateMode": "auto"
}
