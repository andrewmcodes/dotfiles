[core]
excludesfile = ~/.config/git/ignore
editor = code-insiders --wait
pager = delta

[interactive]
diffFilter = delta --color-only

[delta]
navigate = true
line-numbers = true
side-by-side = false
syntax-theme = OneHalfDark

[alias]
tree = log --graph --decorate --oneline --all
tags = tag -l
branches = branch -a
remotes = remote -v
hist = log --graph --pretty=format:'%Cred%h%Creset %s%C(yellow)%d%Creset %Cgreen(%cr)%Creset [%an]'
s = status -sb
cleanup = "!git fetch --prune && git branch -vv | grep ': gone]' | awk '{print $1}' | xargs -n 1 git branch -D"
delete-branches = "!git branch --format='%(refname:short)' | grep -v '^main$\\|^master$' | fzf --multi --preview 'git log --oneline --graph --date=short --pretty=\"format:%C(auto)%cd %h%d %s\" $(git merge-base main {}) | head -n 50' --bind 'ctrl-a:select-all,ctrl-d:deselect-all' --header 'Select branches to delete (TAB to select, ENTER to confirm, CTRL-A select all)' | xargs -r git branch -D"

[push]
default = simple
followTags = true
autoSetupRemote = true
useForceIfIncludes = true

[init]
defaultBranch = main

[pull]
rebase = true

[credential]
helper = cache --timeout=86400

[fetch]
prune = true
fsckObjects = true

[gpg]
format = ssh

[gpg "ssh"]
program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign

[commit]
gpgsign = true

[rerere]
enabled = true
autoupdate = true

[rebase]
autoStash = true
autoSquash = true
updateRefs = true

[merge]
conflictStyle = zdiff3

[diff]
algorithm = histogram
colorMoved = zebra
colorMovedWS = allow-indentation-change
renames = copies
mnemonicPrefix = true

[branch]
sort = -committerdate

[tag]
sort = version:refname

[column]
ui = auto

[status]
showStash = true

[help]
autocorrect = prompt

[transfer]
fsckObjects = true

[receive]
fsckObjects = true
[fetch "fsck"]
	zeroPaddedFilemode = ignore
[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://git.heroku.com"]
	helper = !heroku git:credentials
